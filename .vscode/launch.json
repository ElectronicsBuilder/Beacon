{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug ScoreBoard (ST-Link)",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "stlink",
            "cwd": "${workspaceFolder}/ScoreBoard",
            "executable": "${workspaceFolder}/ScoreBoard/build/Debug/ScoreBoard.elf",
            "device": "STM32F429VITx",
            "interface": "swd",
            "serverpath": "C:/ST/STM32CubeCLT_1.16.0/STLink-gdb-server/bin/ST-LINK_gdbserver.exe",
            "armToolchainPath": "C:/ST/STM32CubeCLT_1.16.0/GNU-tools-for-STM32/bin",
            "svdFile": "C:/ST/STM32CubeCLT_1.16.0/STMicroelectronics_CMSIS_SVD/STM32F429.svd",
            "runToEntryPoint": "main",
            "preLaunchTask": "build",
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 4
            }
        },
        {
            "name": "Attach ScoreBoard (ST-Link, no reset)",
            "type": "cortex-debug",
            "request": "attach",
            "servertype": "stlink",
            "cwd": "${workspaceFolder}/ScoreBoard",
            "executable": "${workspaceFolder}/ScoreBoard/build/Debug/ScoreBoard.elf",
            "device": "STM32F429VITx",
            "interface": "swd",
            "serverpath": "C:/ST/STM32CubeCLT_1.16.0/STLink-gdb-server/bin/ST-LINK_gdbserver.exe",
            "armToolchainPath": "C:/ST/STM32CubeCLT_1.16.0/GNU-tools-for-STM32/bin",
            "svdFile": "C:/ST/STM32CubeCLT_1.16.0/STMicroelectronics_CMSIS_SVD/STM32F429.svd"
        }
    ]
}
