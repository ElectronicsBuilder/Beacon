{
    // CMake project generated by CubeMX lives one folder down
    "cmake.sourceDirectory": "${workspaceFolder}/ScoreBoard",
    "cmake.useCMakePresets": "always",
    "cmake.configureOnOpen": true,

    // Toolchain from STM32CubeCLT
    "cortex-debug.armToolchainPath": "C:/ST/STM32CubeCLT_1.16.0/GNU-tools-for-STM32/bin",
    "cortex-debug.stlinkPath": "C:/ST/STM32CubeCLT_1.16.0/STLink-gdb-server/bin/ST-LINK_gdbserver.exe",
    "cortex-debug.stm32cubeprogrammer": "C:/ST/STM32CubeCLT_1.16.0/STM32CubeProgrammer/bin",
    "C_Cpp.default.compilerPath": "C:/ST/STM32CubeCLT_1.16.0/GNU-tools-for-STM32/bin/arm-none-eabi-gcc.exe",
    // Hide the editor's "Run/Debug C/C++ File" button: it compiles single files
    // with the PC compiler. Use Ctrl+Shift+B (build) and F5 (debug) instead.
    "C_Cpp.debugShortcut": false,

    "sonarlint.pathToCompileCommands": "${workspaceFolder}\\ScoreBoard\\build\\Debug\\compile_commands.json",

    "files.associations": {
        "*.h": "c",
        "*.c": "c"
    },
    "files.exclude": {
        "**/build": false
    }
}
